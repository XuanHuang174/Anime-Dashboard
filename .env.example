# Copy this file to .env and replace every placeholder before deployment.
# Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=www.my-anime-site.com,my-anime-site.com
CORS_ALLOWED_ORIGINS=https://www.my-anime-site.com
CSRF_TRUSTED_ORIGINS=https://www.my-anime-site.com
FRONTEND_URL=https://www.my-anime-site.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False
USER_ANIME_RECORD_LIMIT=3000
CRON_SECRET_KEY=replace-with-a-long-random-cron-secret

# Server-only AnimeSearch gateway. Configure these on the Django Render service.
# A raw key or a single "Bearer " prefix is accepted. Never use VITE_* for it.
ANIME_SEARCH_API_URL=https://xh-anime-search.onrender.com
ANIME_SEARCH_API_KEY=replace-with-your-internal-api-key

# Leave empty for local SQLite. In production, paste the complete Neon
# connection string (including its username, password, host and database).
# Example shape only:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Experimental 5B-2 V2 is NOT enabled by default. Evaluate in 5B-3 before rollout.
RECOMMENDATION_ALGORITHM_VERSION=content.v1
# V2 requires a locally accessible, signed 5B-3 approval for this exact release.
# Never deploy recommendation_test_settings; rollback only needs content.v1.
RECOMMENDATION_V2_APPROVAL_FILE=

# Cloudflare R2 media storage. Leave all required values empty in local
# development to keep using MEDIA_ROOT. AWS_S3_CUSTOM_DOMAIN may be either a
# bare hostname or an https:// URL; use a public R2 custom domain in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Example: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
# Example: media.example.com
AWS_S3_CUSTOM_DOMAIN=

# Recommendation cover downloads: comma-separated exact trusted hostnames.
# Include any trusted CDN redirect hosts; never use * or arbitrary user URLs.
RECOMMENDATION_COVER_ALLOWED_HOSTS=lain.bgm.tv,lain.bangumi.tv,lain.bangumi.lol,storage.moegirl.org.cn,s4.anilist.co

# Optional official Bangumi personal access token. Standalone preparation CLI
# intentionally does NOT load .env: set BANGUMI_ACCESS_TOKEN in its process
# environment only. Never put it in command arguments, VITE_*, Git or logs.
BANGUMI_ACCESS_TOKEN=

# Optional self-hosted Bangumi reverse proxies. Use origins only: do not append
# /v0 to the API proxy and do not append /pic to the image proxy.
BANGUMI_PROXY_API=https://api-bgm.example.com
BANGUMI_PROXY_IMAGE=https://img-bgm.example.com
# Optional public v0-compatible fallback for local networks that cannot reach
# api.bgm.tv/workers.dev. Leave blank to disable it.
BANGUMI_FALLBACK_API=https://api.bangumi.lol
# Local-only switch: use the reachable public mirror before your Worker. Keep
# this False/undefined on Render so production still prefers your own proxy.
BANGUMI_PREFER_FALLBACK=False

# Production transactional email (recommended): Resend HTTPS API over port 443.
TRANSACTIONAL_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Anime Dashboard <noreply@your-verified-domain.com>"
RESEND_API_URL=https://api.resend.com/emails
RESEND_CONNECT_TIMEOUT=3.05
RESEND_READ_TIMEOUT=8

# Optional local/legacy SMTP fallback. For Resend STARTTLS testing, use
# smtp.resend.com / 587 / user "resend" / API key as password, with TLS=True.
EMAIL_HOST_USER=your-account@qq.com
EMAIL_HOST_PASSWORD=your-qq-smtp-authorization-code

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=your-account@qq.com
