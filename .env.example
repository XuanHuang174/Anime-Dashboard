# Copy this file to .env and replace every placeholder before deployment.
# Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=www.my-anime-site.com,my-anime-site.com
CORS_ALLOWED_ORIGINS=https://www.my-anime-site.com
CSRF_TRUSTED_ORIGINS=https://www.my-anime-site.com
FRONTEND_URL=https://www.my-anime-site.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False
USER_ANIME_RECORD_LIMIT=3000

# Optional self-hosted Bangumi reverse proxies. Use origins only: do not append
# /v0 to the API proxy and do not append /pic to the image proxy.
BANGUMI_PROXY_API=https://api-bgm.example.com
BANGUMI_PROXY_IMAGE=https://img-bgm.example.com

# EMAIL_HOST_PASSWORD must be the QQ SMTP authorization code, not the login password.
EMAIL_HOST_USER=your-account@qq.com
EMAIL_HOST_PASSWORD=your-qq-smtp-authorization-code

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=your-account@qq.com
