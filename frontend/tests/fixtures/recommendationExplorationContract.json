  "search": {
    "contract_version": "recommendations.explore.catalog.v1",
    "limit": 15,
    "max_query_length": 120,
    "identity_namespace": "bangumi"
  },
  "query": {
    "intents": {
      "similar": "similarity.v1",
      "tags": "tag-explore.v1"
    },
    "maximum_include_tags": 5,
    "maximum_exclude_tags": 5,
    "default_match": "all",
    "matches": [
      "all",
      "any"
    ],
    "sorts": [
      "relevance",
      "score"
    ],
    "fields": [
      "intent",
      "seed_bangumi_id",
      "include_tags",
      "exclude_tags",
      "match",
      "sort",
      "type",
      "min_score",
      "max_score",
      "max_score_exclusive",
      "year_from",
      "year_to",
      "hide_recorded",
      "page_size"
    ],
    "requires_profile": false,
    "saves_preferences": false
  },
  "evidence": {
    "contract_version": "recommendations.explore.evidence.v1",
    "kinds": {
      "similar": "selected_work",
      "tags": "selected_tags"
    },
    "interpretation": "shared_genre_association",
    "is_probability": false,
    "fields": [
      "contract_version",
      "kind",
      "interpretation",
      "is_probability",
      "shared_tags",
      "source",
      "versions"
    ],
    "source_fields": {
      "selected_work": [
        "bangumi_id",
        "title",
        "tags"
      ],
      "selected_tags": []
    },
    "required_context": [
      "query_fingerprint",
      "catalog_feature_version",
      "scope_revision",
      "taxonomy_version",
      "ranking_policy_version"
    ],
    "private_score_source": false
  },
  "limits": {
    "catalog_rows": 50000,
    "results": 120,
    "batch_size": 24,
    "page_size": 12,
    "snapshot_ttl_seconds": 900
  }
}
